def die(msg):
    sys.exit(f"bench: {msg}")


def sh(cmd, **kw):
    return subprocess.run(cmd, capture_output=True, text=True, **kw).stdout


def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for block in iter(lambda: f.read(1 << 20), b""):
            h.update(block)
    return h.hexdigest()


# ---------------------------------------------------------------------------------------------- the machine
def fake(name):
    return (Path(FAKE) / name).read_text() if FAKE and (Path(FAKE) / name).exists() else None


REASONS = None   # nvidia-smi's field of the clock-event reasons, found once ("" without nvidia-smi)


def reasons_field():
    """nvidia-smi's field of the clock-event reasons (renamed by newer drivers); None without nvidia-smi."""
    global REASONS
    if REASONS is None:
        REASONS = ""
        names = ("clocks_event_reasons.active", "clocks_throttle_reasons.active")
        for f in names if shutil.which("nvidia-smi") else ():
            out = sh(["nvidia-smi", f"--query-gpu={f}", "--format=csv,noheader,nounits"])
            if out.strip() and "Field" not in out:
                REASONS = f
                break
    return REASONS or None


def num(x, base=10):
    """A number nvidia-smi printed; None for its [N/A] or [Not Supported]."""
    try:
        return int(x, base)
    except ValueError:
        return None


def gpus():
    """Linux: how many cards nvidia-smi sees (0 without it)."""
    out = fake("nvidia-smi.csv")
    if out is None:
        out = sh(["nvidia-smi", "-L"]) if shutil.which("nvidia-smi") else ""
    return len([l for l in out.split("\n") if l.strip()])


def gpu():
    """Linux: card GPU's name, temperature, SM clock, clock-event reasons, memory used (None for a field the card
    does not report); None without nvidia-smi."""
    out = fake("nvidia-smi.csv")
    if out is None:
        if not reasons_field():
            return None
        out = sh(["nvidia-smi", "-i", GPU, f"--query-gpu=name,temperature.gpu,clocks.sm,{reasons_field()},memory.used",
                  "--format=csv,noheader,nounits"])
    lines = out.strip().split("\n")   # -i gives one line; the tests' fake file has a line a card
    f = [x.strip() for x in lines[int(GPU) if FAKE else 0].split(",")]
    return {"name": f[0], "temp": num(f[1]), "sm": f[2], "reasons": num(f[3], 16), "mem_mib": f[4]}


@contextlib.contextmanager
def watch(path, err):
    """Linux: nvidia-smi reads the card every WATCH_MS (temperature, SM clock, utilization, clock-event reasons) into
    path, from the harness's «ready in» line in err (the model loaded: before it the card takes copies at a low
    clock) to the run's end. The checks before and after a run see an idle card: a brake inside a run shows only
    here. It costs a process that wakes once a second, the same for every version."""
    f = reasons_field() if SYSTEM == "Linux" and not FAKE else None
    if not f:
        yield
        return
    stop = threading.Event()

    def sample():
        while "ready in" not in (err.read_text(errors="replace") if err.exists() else ""):
            if stop.wait(0.2):
                return
        with open(path, "w") as o:
            p = subprocess.Popen(["nvidia-smi", "-i", GPU, f"--query-gpu=temperature.gpu,clocks.sm,utilization.gpu,{f}",
                                  "--format=csv,noheader,nounits", "-lms", str(WATCH_MS)], stdout=o,
                                 stderr=subprocess.DEVNULL)
            stop.wait()
            p.terminate()
            p.wait()

    th = threading.Thread(target=sample)
    th.start()
    try:
        yield
    finally:
        stop.set()
        th.join()


def card_while_running(path):
    """A run's samples (the model loaded): the hottest °C; over those with a kernel running (utilization above 0),
    the median SM clock, the share under the power cap, the hot brakes seen (a mask) and their share. Without such
    samples, how many lines the file has: the files before 29/10 have no utilization and start at the load."""
    rows, lines = [], [l for l in path.read_text().split("\n") if l.strip()]
    for l in lines:
        f = [x.strip() for x in l.split(",")]
        if len(f) == 4 and all(x.isdigit() for x in f[:3]) and f[3].startswith("0x"):
            rows.append((int(f[0]), int(f[1]), int(f[2]), int(f[3], 16)))
    work = [r for r in rows if r[2] > 0]
    if not work:
        return {"n": 0, "lines": len(lines)}
    hot = [r[3] & NVIDIA_HOT for r in work if r[3] & NVIDIA_HOT]
    mask = 0
    for h in hot:
        mask |= h
    return {"temp": max(r[0] for r in rows), "sm": statistics.median(r[1] for r in work),
            "power": sum(bool(r[3] & NVIDIA_POWER_CAP) for r in work) / len(work), "hot": mask,
            "hot_share": len(hot) / len(work), "n": len(work)}


def cpu_cores():
    """Linux: each logical CPU's core, as 'cpu package:core' lines (two CPUs on one core are SMT siblings)."""
    lines = []
    for d in sorted(Path("/sys/devices/system/cpu").glob("cpu[0-9]*"), key=lambda p: int(p.name[3:])):
        t = d / "topology"
        if (t / "core_id").exists():
            pkg, core = ((t / x).read_text().strip() for x in ("physical_package_id", "core_id"))
            lines.append(f"{d.name[3:]} {pkg}:{core}")
    return "\n".join(lines) + "\n" if lines else ""


def cpu_set(s):
    """An OpenMP CPU set, '0,6' or '0-3,8', as a list."""
    out = []
    for part in s.split(","):
        a, _, b = part.partition("-")
        out += list(range(int(a), int(b or a) + 1))
    return out


def threads(paths, cores):
    """The run's OpenMP team (OMP_SHOW) from its .err, or its .csv (libomp prints it on stdout): how many threads,
    the CPUs they are bound to, how many cores; None for the cores when a thread may run on more than one core
    (no OMP_PROC_BIND: each thread has every CPU of the process), and then the CPUs once each."""
    text = "".join(p.read_text() for p in paths if p.exists())
    team = {}
    for n, cpus in re.findall(r"omp-thread:(\d+):cpus:([0-9,-]+)", text):
        team.setdefault(int(n), cpu_set(cpus))
    if not team:
        return None
    cpus = [c for n in sorted(team) for c in team[n]]
    if any(len({cores.get(c, f"cpu{c}") for c in team[n]}) > 1 for n in team):
        return len(team), sorted(set(cpus)), None
    return len(team), cpus, len({cores.get(c, f"cpu{c}") for c in cpus})


def meminfo():
    text = fake("meminfo.txt") or Path("/proc/meminfo").read_text()
    return {k: int(v.split()[0]) for k, v in (l.split(":", 1) for l in text.strip().split("\n"))}


def swap():
    """What is in the swap, and the pages the system has written to it since boot (16 KiB on macOS, 4 on Linux)."""
    if SYSTEM == "Darwin":
        used = sh(["sysctl", "-n", "vm.swapusage"]).split()[5]
        outs = re.search(r"Swapouts:\s+(\d+)", sh(["vm_stat"])).group(1)
        return f"swap_used={used} swapouts={outs}"
    m = meminfo()
    vmstat = fake("vmstat.txt") or Path("/proc/vmstat").read_text()
    outs = re.search(r"^pswpout (\d+)", vmstat, re.M)
    return f"swap_used={(m['SwapTotal'] - m['SwapFree']) / 1024:.2f}M swapouts={outs.group(1) if outs else 0}"


def chrome():
    if SYSTEM != "Darwin":
        return 0
    return sum("Google Chrome" in l for l in (fake("ps.txt") or sh(["ps", "-axo", "comm"])).split("\n"))


def thermal():
    """macOS: the thermal state (0 nominal, 1 fair, 2 serious, 3 critical). Linux: the card's state as one word."""
    if SYSTEM == "Darwin":
        return sh(["osascript", "-l", "JavaScript", "-e",
                   'ObjC.import("Foundation"); $.NSProcessInfo.processInfo.thermalState']).strip()
    g = gpu()
    if not g:
        return "no-gpu"
    if g["temp"] is None or g["reasons"] is None:   # nothing to wait for: the report says so
        return "no-temp"
    return f"temp={g['temp']} sm={g['sm']} reasons=0x{g['reasons']:x}"


def is_cool(state, max_temp=None):
    """macOS's state 0, or a card without a hot clock-event reason (and under max_temp, when waiting for it)."""
    m = re.match(r"temp=(\d+) sm=\S+ reasons=0x([0-9a-f]+)", state)
    if not m:
        return state in ("0", "no-gpu", "no-temp")
    return not int(m.group(2), 16) & NVIDIA_HOT and (max_temp is None or int(m.group(1)) < max_temp)


def cool(max_temp, limit=900):
    """Wait until the machine is cool, at most `limit` seconds: the MacBook Air has no fan, a card slows when hot."""
    waited = 0
    while not is_cool(thermal(), max_temp) and waited < limit:
        time.sleep(10)
        waited += 10
    return waited


def host_state():
    now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    if SYSTEM == "Darwin":
        free = sh(["memory_pressure", "-Q"]).strip().split("\n")[-1]
        return f"{now} chrome={chrome()} {free} {swap()}"
    m = meminfo()
    out = f"{now} mem_available={m['MemAvailable'] / 2**20:.2f}GiB"
    limit = fake("memory.max") or (Path("/sys/fs/cgroup/memory.max").read_text()
                                   if Path("/sys/fs/cgroup/memory.max").exists() else None)
    if limit and limit.strip() != "max":   # in a container the cgroup is the real ceiling, not /proc/meminfo
        used = fake("memory.current") or Path("/sys/fs/cgroup/memory.current").read_text()
        out += f" cgroup_max={int(limit) / 2**30:.2f}GiB cgroup_used={int(used) / 2**30:.2f}GiB"
    g = gpu()
    if g:
        out += f" gpu={g['name'].replace(' ', '_')} temp={g['temp']} sm={g['sm']} " \
               f"reasons={'?' if g['reasons'] is None else hex(g['reasons'])} gpu_mem_used={g['mem_mib']}MiB"
    return f"{out} {swap()}"


def time_cmd():
    """The process's peak memory: /usr/bin/time -l on macOS, -v on Linux when it is there."""
    if SYSTEM == "Darwin":
        return ["/usr/bin/time", "-l"]
    return ["/usr/bin/time", "-v"] if os.path.exists("/usr/bin/time") else []


def busy(binary_names):
    """Another measurement or a build would steal the machine: refuse to start (and before every run: the lock keeps
    out another bench run, not a harness started by hand)."""
    for name in ["make", "clang", "gcc", "nvcc"] + binary_names:
        if sh(["pgrep", "-x", name]).strip():
            return name
    return None


def unread(binary, env):
    """The variables of env the binary never names: getenv's names are NUL-ended strings in it. A typo, or a mode
    this build does not have, would run as the base and print «same results»."""
    data = Path(binary).read_bytes()
    names = dict.fromkeys(x.split("=", 1)[0] for x in env)
    return [n for n in names if not n.startswith(RUNTIME_ENV) and n.encode() + b"\0" not in data]


def hardware():
    if SYSTEM == "Darwin":
        cpu = f"{sh(['sysctl', '-n', 'machdep.cpu.brand_string']).strip()} ({sh(['sysctl', '-n', 'hw.model']).strip()})"
        ram = f"{int(sh(['sysctl', '-n', 'hw.memsize'])) / 2**30:.0f} GB"
        disk = re.search(r"Device / Media Name:\s*(.+)", sh(["diskutil", "info", "/"]))
        osv = f"macOS {sh(['sw_vers', '-productVersion']).strip()} ({sh(['sw_vers', '-buildVersion']).strip()})"
        return {"cpu": cpu, "ram": ram, "storage": disk.group(1).strip() if disk else "unknown", "os": osv}
    cpu = re.search(r"model name\s*:\s*(.+)", Path("/proc/cpuinfo").read_text())
    osr = re.search(r'PRETTY_NAME="(.+)"', Path("/etc/os-release").read_text())
    g = gpu()
    hw = {"cpu": cpu.group(1) if cpu else platform.processor(), "ram": f"{meminfo()['MemTotal'] / 2**20:.0f} GiB",
          "storage": sh(["df", "-h", "--output=source,size", "/"]).strip().split("\n")[-1],
          "os": f"{osr.group(1) if osr else 'Linux'}, kernel {platform.release()}"}
    if g:
        hw["gpu"] = g["name"]
    return hw


# ---------------------------------------------------------------------------------------------------- build
def git_repo(arg):
    if arg:
        return Path(arg)
    for d in (Path.cwd(), HERE):
        top = sh(["git", "-C", str(d), "rev-parse", "--show-toplevel"]).strip()
        if top:
            return Path(top)
    die("no git repository: pass --repo")


def build(target, out, engine, cuda=False, repo=None, make_args=(), serve_model=None):
    """The harness against one version of the engine: a commit (exported with git archive) or a source directory
    used as it is. The objects come from the engine's own Makefile; the link is the line `make` would run for the
    engine, with the harness in place of the engine's main file, without -MMD/-MP and the qpack path (a CPU
    conversion the harness never calls: as in every record so far)."""
    e = ENGINES[engine]
    out = Path(out).resolve()
    out.mkdir(parents=True, exist_ok=True)
    if Path(target).is_dir():
        src = Path(target).resolve()
        src = src / "c" if (src / "c").is_dir() else src
        head = sh(["git", "-C", str(src), "rev-parse", "HEAD"]).strip()
        dirty = sh(["git", "-C", str(src), "status", "--porcelain", "--", "."]).strip()
        version = f"source {src} at {head[:8] or '?'}{' + uncommitted changes' if dirty else ''}"
    else:
        repo = git_repo(repo)
        head = sh(["git", "-C", str(repo), "rev-parse", "--verify", f"{target}^{{commit}}"]).strip()
        if not head:
            die(f"{target}: not a commit of {repo}, nor a directory")
        shutil.rmtree(out / "src", ignore_errors=True)
        (out / "src").mkdir()
        tar = subprocess.run(["git", "-C", str(repo), "archive", head, "c"], capture_output=True, check=True).stdout
        subprocess.run(["tar", "-x", "-C", str(out / "src")], input=tar, check=True)
        src = out / "src/c"
        version = f"commit {head}"
    flags = ["CUDA=1"] if cuda else ["METAL=1"] if SYSTEM == "Darwin" else []
    flags += list(make_args)
    if serve_model:   # a session through SERVE=1 (serve_session): the engine's own main, the one the server runs
        art = sh([sys.executable, "-c", "import sys; sys.path.insert(0, sys.argv[1]); import openai_server as o; "
                  "print(o.resolve_model(sys.argv[2]).descriptor.engine_artifact)", str(src), str(serve_model)]).strip()
        if not art:
            die(f"{serve_model}: the server of {src} names no engine for it")
        r = subprocess.run(["make", "-s", art] + flags, cwd=src, capture_output=True, text=True)
        (out / "build.txt").write_text(f"{version}\nmake flags: {' '.join(flags) or 'none'}\nmake {art}, run through "
                                       f"SERVE=1\n{r.stderr}")
        if r.returncode:
            die(f"make {art} failed:\n{r.stderr[-3000:]}")
        (out / "version.txt").write_text(f"{version}; the engine's main {art} through SERVE=1{'; CUDA' if cuda else ''}\n")
        print(f"built {src / art} ({version})")
        return src / art
    dry = sh(["make", "-n", "-W", e["engine_c"], e["target"]] + flags, cwd=src)
    line = next((l for l in dry.split("\n")
                 if f" {e['engine_c']} " in f" {l} " and re.search(rf"-o {e['target']}(\.exe)?\b", l)), None)
    if not line:
        die(f"make -n {e['target']} {' '.join(flags)} printed no link line for {e['engine_c']}")
    words = [w for w in shlex.split(line) if w not in ("-MMD", "-MP", "-DQWEN36_QPACK")
             and not w.startswith(("qwen36_qpack", "qpack"))]
    objects = [w for w in words if w.endswith(".o")]
    vulkan = "-DCOLI_VULKAN" in words
    if vulkan:   # VK=1: the shaders are the engine's prerequisites, not the objects'; -B lists them all
        every = sh(["make", "-n", "-B", e["target"]] + flags, cwd=src)
        spv = sorted(set(re.findall(r"-o (shaders/\S+\.spv)", every)))
        if not spv:
            die(f"make -n -B {e['target']} {' '.join(flags)} printed no shader: Vulkan would not start")
        objects += spv
    if objects:
        r = subprocess.run(["make", "-s"] + objects + flags, cwd=src, capture_output=True, text=True)
        if r.returncode:
            die(f"make {' '.join(objects)} failed:\n{r.stderr[-3000:]}")
    i = words.index(e["engine_c"])
    words[i:i + 1] = [f"-I{src}", str(HERE / e["source"])]
    o = words.index("-o")
    words[o + 1] = str(out / e["binary"])
    r = subprocess.run(words, cwd=src, capture_output=True, text=True)
    (out / "build.txt").write_text(f"{version}\nmake flags: {' '.join(flags) or 'none'}\n"
                                   f"harness: {e['source']} sha256 {sha256(HERE / e['source'])}\n"
                                   f"cd {src} && {shlex.join(words)}\n{r.stderr}")
    if r.returncode:
        die(f"the harness did not build:\n{r.stderr[-3000:]}")
    if vulkan:   # the engine looks for shaders/ next to its binary (coli_vk_shader_path), as make lays them out
        link = out / "shaders"
        if link.is_symlink():
            link.unlink()
        link.symlink_to(src / "shaders")
    warnings = r.stderr.count("warning:")
    (out / "version.txt").write_text(f"{version}; harness {e['source']} {sha256(HERE / e['source'])[:12]}"
                                     f"{'; CUDA' if cuda else ''}{'; Vulkan' if vulkan else ''}\n")
    print(f"built {out / e['binary']} ({version}; {warnings} warnings)")
    return out / e["binary"]


