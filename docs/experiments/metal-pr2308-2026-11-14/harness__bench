def read_csv(path):
    # without the lines of OMP_SHOW: libomp (an engine built with clang) prints them on stdout
    lines = [l for l in path.read_text().strip().split("\n") if l and not l.startswith("omp-thread:")]
    if not lines:
        return []
    head = lines[0].split(",")
    missing = [c for c in COLS if c not in head]
    if missing:
        die(f"{path}: not the CSV contract, missing {missing}")
    return [dict(zip(head, l.split(","))) for l in lines[1:]]


def read_steps(path):
    """A step file: '<length|turn> <step> <reads> <reads' s> <ms> [<MB to the card>]' a line (the MB on CUDA), the
    prompt as step -1. A length met again (64,512,64: the 64 after the 512 and its words) starts at its prompt line
    and takes row_keys' key."""
    out, seen, key = {}, {}, {}
    for l in path.read_text().split("\n"):
        if l.strip():
            n, g, miss, disk, ms, *bus = l.split()
            n, g = int(n), int(g)
            if g == -1:
                seen[n] = seen.get(n, 0) + 1
                key[n] = n if seen[n] == 1 else f"{n}#{seen[n]}"
            out.setdefault(key.get(n, n), {})[g] = (int(miss), float(disk), float(ms), float(bus[0]) if bus else None)
    return out


def row_keys(rows):
    """Each CSV row's key: its length, or "<n>#<k>" for the k-th time a length comes back; and its label in the
    tables, "64 after 512" for one that comes back ("16 after 100 #3" if that label is taken)."""
    seen, keys = {}, []
    for i, r in enumerate(rows):
        n = int(r["ctx_tokens"])
        seen[n] = seen.get(n, 0) + 1
        label = f"{n} after {rows[i - 1]['ctx_tokens']}" if seen[n] > 1 else str(n)
        if label in (l for _, l in keys):
            label += f" #{seen[n]}"
        keys.append((n if seen[n] == 1 else f"{n}#{seen[n]}", label))
    return keys


def run_names(out):
    names = {}
    for p in out.glob("v*-run*.csv"):
        m = re.match(r"(v\d+)-run(\d+)$", p.stem)
        if m:
            names.setdefault(m.group(1), []).append((int(m.group(2)), p.stem))
    return {v: [n for _, n in sorted(r)] for v, r in sorted(names.items())}


def err_numbers(err):
    text = err.read_text() if err.exists() else ""
    foot = re.search(r"(\d+)\s+peak memory footprint", text)
    rss = re.search(r"Maximum resident set size \(kbytes\): (\d+)", text)
    gb = re.search(r"\[bench\] peak RSS ([\d.]+) GB", text)
    ready = re.search(r"ready in ([\d.]+) s", text)
    mib = int(foot.group(1)) / 2**20 if foot else int(rss.group(1)) / 1024 if rss else \
        float(gb.group(1)) * 1024 if gb else None
    return mib, float(ready.group(1)) if ready else None


def cell(xs, d):
    return f"{statistics.median(xs):.{d}f} ({min(xs):.{d}f}–{max(xs):.{d}f})"


def verdict(a, b, higher_better=True):
    """Medians' change, positive = faster, and whether every run of b beats (or loses to) every run of a; below
    MIN_VERDICT runs a side, no verdict."""
    ma, mb = statistics.median(a), statistics.median(b)
    if ma <= 0 or mb <= 0:
        return "-"
    pct = 100 * ((mb / ma if higher_better else ma / mb) - 1)
    if min(len(a), len(b)) < MIN_VERDICT:
        return f"{pct:+.1f}%, too few runs for a verdict"
    better = min(b) > max(a) if higher_better else max(b) < min(a)
    worse = max(b) < min(a) if higher_better else min(b) > max(a)
    return f"{pct:+.1f}%, {'every run faster' if better else 'every run slower' if worse else 'ranges overlap'}"


def blocks(gen):
    """Steps 2..gen in blocks that double (2-32, 33-64, 65-128, ...), as 0-based step indices."""
    out, lo = [], 1
    for hi in (31, 63, 127, 255, 511, 1023, 2047, 4095):
        if lo > gen - 1:
            break
        out.append((lo, min(hi, gen - 1)))
        lo = hi + 1
    return out


def labels(out):
    lab = {}
    for l in (out / "setup.txt").read_text().split("\n") if (out / "setup.txt").exists() else []:
        m = re.match(r"(v\d+) (\S+): ", l) or re.match(r"(v\d+): (\S+)", l)
        if m:
            lab[m.group(1)] = m.group(2) if not m.group(2).startswith("/") else Path(m.group(2)).parent.name
    return lab


def report(out):
    out = Path(out)
    names, lab = run_names(out), labels(out)
    if not names:
        die(f"{out}: no runs")
    data = {v: {r: read_csv(out / f"{r}.csv") for r in rs} for v, rs in names.items()}
    steps = {v: {r: read_steps(out / f"{r}.steps") for r in rs if (out / f"{r}.steps").exists()}
             for v, rs in names.items()}
    for v, rs in data.items():                  # every step file is its run's
        for r, rows in rs.items():
            st = steps[v].get(r)
            if not rows:
                die(f"{r}.csv: no rows")
            keys = None if "reused" in rows[0] else row_keys(rows)
            for i, row in enumerate(rows):
                key = i + 1 if keys is None else keys[i][0]
                if st is None or "expert_miss" not in row:
                    continue
                s = st.get(key)
                if not s or sum(x[0] for x in s.values()) != int(row["expert_miss"]):
                    die(f"{r}.steps: the reads of {key} do not add up to the CSV's expert_miss")
                if abs(s[-1][2] - float(row["prefill_s"]) * 1e3) > 2.0:
                    die(f"{r}.steps: the prompt time of {key} is not the CSV's prefill_s")
    session = "reused" in next(iter(next(iter(data.values())).values()))[0]
    if not session:   # a run cut short (a VM gone, a Ctrl-C) would drop its rows from every table
        rows_n = {r: len(rows) for rs in data.values() for r, rows in rs.items()}
        if len(set(rows_n.values())) > 1:
            die("the runs do not all have the same rows, one was cut short: " +
                ", ".join(f"{r} {n}" for r, n in rows_n.items()))
    setup = (out / "setup.txt").read_text() if (out / "setup.txt").exists() else ""
    head, warn = [f"# bench: {out.name}", ""], []
    for l in setup.split("\n")[:3] + [l for l in setup.split("\n")[3:] if re.match(r"v\d+[ :]", l)]:
        head.append("- " + re.sub(r"(/[^\s;()]+/)+", "", l))   # what ran, without local directories
    warn += [l[len("warning: "):] for l in setup.split("\n") if l.startswith("warning: ")]
    planned = re.search(r"then (\d+) per version", setup)
    for v in sorted(set(lab) | set(names)):
        if planned and len(names.get(v, [])) < int(planned.group(1)):
            warn.append(f"INCOMPLETE: {v} {lab.get(v, '')} has {len(names.get(v, []))} of the "
                        f"{planned.group(1)} runs planned")
    md = []
    (session_report if session else lengths_report)(out, md, names, lab, data, steps)
    warm = out / "warmup.csv"
    if warm.exists() and not session:
        md += ["", "warm-up (does not count): " + "; ".join(
            f"{r['ctx_tokens']} tokens: prompt {float(r['prefill_tps']):.2f} tok/s, decode "
            f"{float(r['gen_steady_tps']):.3f} tok/s" for r in read_csv(warm))]
    hot, notemp = [], []
    top = re.search(r"the card under (\d+) °C", setup)   # before a run a card must be under it too
    for p in sorted(out.glob("*.thermal-*.txt")):
        state, before = p.read_text().split("\n")[1], p.name.endswith("before.txt")
        if not is_cool(state, (int(top.group(1)) if top else 70) if before else None):
            hot.append(f"{p.name.split('.thermal')[0]} ({p.name.split('-')[-1][:-4]}: {state})")
        if state == "no-temp":
            notemp.append(p.name.split(".thermal")[0])
    card, team, blind, backend = {}, {}, [], {}
    cores = {int(c): k for c, k in (l.split() for l in (out / "cpus.txt").read_text().split("\n") if l.strip())} \
        if (out / "cpus.txt").exists() else {}
    for v, rs in names.items():
        for r in rs:
            c = card_while_running(out / f"{r}.gpu.txt") if (out / f"{r}.gpu.txt").exists() else None
            if c and not c["n"]:
                blind.append(f"{r} ({c['lines']} lines)")
            elif c:
                card.setdefault(v, []).append(c)
                if c["hot"]:
                    hot.append(f"{r} (while running: 0x{c['hot']:x} in {c['hot_share']:.0%} of the samples with a "
                               f"kernel, up to {c['temp']} °C)")
            t = threads([out / f"{r}.err", out / f"{r}.csv"], cores)
            if t:
                team.setdefault(v, []).append(t)
            m = re.search(r"\[bench\] (.+?) ready in", (out / f"{r}.err").read_text(errors="replace")) \
                if (out / f"{r}.err").exists() else None
            backend.setdefault(v, set()).add(m.group(1) if m else "?")
    if hot:
        warn.append("runs not cool (below)")
    if notemp:
        warn.append(f"the card reported no temperature before or after {', '.join(sorted(set(notemp)))}: "
                    f"nothing was waited for")
    if len(set().union(*backend.values())) > 1:
        warn.append("the runs did not all run on one backend (below)")
    if any(b != {"?"} for b in backend.values()):
        md.append("backend: " + "; ".join(f"{v} {lab.get(v, '')} {', '.join(sorted(b))}" for v, b in backend.items()))
    md.append(f"runs not cool: {', '.join(hot) if hot else 'none'}")
    if blind:
        md.append(f"the card while running: no samples with a kernel running in {', '.join(blind)} (older files "
                  f"have no utilization column)")
    if card:
        md.append("the card while running (samples with a kernel running; median, min–max of the runs): " + "; ".join(
            f"{v} {lab.get(v, '')} SM {cell([c['sm'] for c in cs], 0)} MHz, under the power cap "
            f"{cell([100 * c['power'] for c in cs], 0)} % of the samples, up to {max(c['temp'] for c in cs)} °C, "
            f"{cell([c['n'] for c in cs], 0)} samples"
            for v, cs in card.items()))
    if team:
        md.append("threads: " + "; ".join(
            f"{v} {lab.get(v, '')} " + ", ".join(f"{n} on {k} cores (CPUs {','.join(map(str, cpus))})" if k else
                                                f"{n} not bound (each may run on CPUs {','.join(map(str, cpus))})"
                                                for n, cpus, k in sorted(set((n, tuple(c), k) for n, c, k in ts),
                                                                         key=str))
            for v, ts in team.items()))
    outs = lambda f: int(m.group(1)) if (out / f).exists() and (m := re.search(r"swapouts=(\d+)",
                                                                              (out / f).read_text())) else None
    if None not in (outs("host-before.txt"), outs("host-after.txt")):
        runs = [outs(f"{r}.thermal-after.txt") - outs(f"{r}.thermal-before.txt") for rs in names.values() for r in rs
                if None not in (outs(f"{r}.thermal-before.txt"), outs(f"{r}.thermal-after.txt"))]
        md.append(f"pages written to swap during the measurement: {outs('host-after.txt') - outs('host-before.txt')}"
                  + (f", {sum(runs)} of them in the runs that count" if runs else ""))
    text = "\n".join(head + [f"- **warning**: {w}" for w in warn] + [""] + md) + "\n"
    (out / "summary.md").write_text(text)
    print(text)
    files = sorted(p for p in out.rglob("*") if p.is_file() and p.name != "sha256.txt" and   # a build's sources: no
                   (not p.relative_to(out).parts[0].startswith("bin-") or len(p.relative_to(out).parts) == 2))
    (out / "sha256.txt").write_text("".join(f"{sha256(p)}  {p.relative_to(out)}\n" for p in files))


def results(x, y, teacher):
    """The same logits in every run of both versions (the fingerprints), or the same words. A teacher-forced text
    gives both versions the text's words: there only the logits and the nll can tell."""
    if len(x["fp"]) == 1 and x["fp"] == y["fp"]:
        return "same results"
    if teacher:
        return "logits differ"
    if len(x["words"]) == 1 and x["words"] == y["words"]:
        return "same words, logits differ"
    return "RESULTS DIFFER"


def nll_change(a, b):
    return f"{100 * (b / a - 1):+.2f}%" if a > 0 else "-"


def lengths_report(out, md, names, lab, data, steps):
    med, label_of = {}, {}
    for v, rs in data.items():
        runs = list(rs.values())
        first = runs[0]
        opt = [c for c in OPT_COLS if c in first[0]]
        teacher = "nll" in first[0] and float(first[0]["nll"]) > 0
        mem = [err_numbers(out / f"{r}.err") for r in rs]
        head = ["tokens", "new", "prompt tok/s", "first step ms", "decode tok/s"] + \
            [OPT_COLS[c][0] for c in opt] + ["nll", "top1"] * teacher + ["fingerprint"]
        md += [f"## {v} {lab.get(v, '')}: {len(runs)} run{'s' * (len(runs) > 1)} (median, min–max)", "",
               "| " + " | ".join(head) + " |", "|" + "---|" * len(head)]
        keys = row_keys(first)
        for i, r0 in enumerate(first):
            col = lambda k: [float(rows[i][k]) for rows in runs]
            fps = {rows[i]["fingerprint"] for rows in runs}
            n, label = keys[i]
            label_of[n] = label
            med[(v, n)] = {"prefill_tps": col("prefill_tps"), "gen_first_ms": col("gen_first_ms"),
                           "gen_steady_tps": col("gen_steady_tps"), "fp": fps,
                           "words": {rows[i]["tokens"] for rows in runs},
                           "nll": statistics.median(col("nll")) if teacher else None,
                           "top1": statistics.median(col("top1")) if teacher else None}
            g = int(r0["gen_tokens"])   # no decode speed below 2 words, no first step without one
            md.append(f"| {label} | {r0['prefill_tokens']} | {cell(col('prefill_tps'), 2)} | "
                      f"{cell(col('gen_first_ms'), 0) if g else '-'} | "
                      f"{cell(col('gen_steady_tps'), 3) if g > 1 else '-'} | " +
                      "".join(f"{statistics.median(col(c)):.{OPT_COLS[c][1]}f} | " for c in opt) +
                      (f"{statistics.median(col('nll')):.4f} | {statistics.median(col('top1')):.3f} | "
                       if teacher else "") +
                      (f"{next(iter(fps))} |" if len(fps) == 1 else f"DIFFERENT between runs: {sorted(fps)} |"))
        foot = [m[0] for m in mem if m[0]]
        ready = [m[1] for m in mem if m[1]]
        md.append("")
        if foot:
            md.append(f"peak memory {statistics.median(foot):.0f} MiB" +
                      (f", model ready in {statistics.median(ready):.2f} s" if ready else "") + " (medians)")
        if steps[v] and len(steps[v]) == len(rs):
            gen = int(first[0]["gen_tokens"])
            bus = steps_bus(steps[v])
            md += ["", f"decode by steps (step 1 gives the second new word; medians of {len(runs)} runs):", "",
                   f"| tokens | steps | {OPT_COLS['expert_miss'][0]} | decode tok/s | reads' s |" +
                   " MB to the card |" * bus, "|---|---|---|---|---|" + "---|" * bus]
            for n, label in keys:
                for lo, hi in blocks(gen) + ([(1, gen - 1)] if len(blocks(gen)) > 1 else []):
                    b = block_stats(steps[v], n, lo, hi)
                    med.setdefault(("steps", v, n, lo, hi), b)
                    md.append(f"| {label} | {lo + 1} to {hi + 1} | {statistics.median(b[0]):.0f} | "
                              f"{statistics.median(b[1]):.3f} | {statistics.median(b[2]):.3f} |" +
                              (f" {statistics.median(b[3]):.1f} |" if bus else ""))
        md.append("")
    vs = list(data)
    if len(vs) == 2:
        a, b = vs
        md += [f"## {b} {lab.get(b, '')} against {a} {lab.get(a, '')} (medians of {len(data[a])} and "
               f"{len(data[b])} runs; positive = faster)", "",
               "| tokens | prompt | first step | decode | results |", "|---|---|---|---|---|"]
        for (v, n), x in [(k, m) for k, m in med.items() if len(k) == 2 and k[0] == a]:
            y = med.get((b, n))
            if not y:
                continue
            teacher = x["nll"] is not None and y["nll"] is not None
            same = results(x, y, teacher)
            if teacher:
                if x["words"] != y["words"]:
                    die(f"{label_of[n]} tokens: teacher-forced, but the two versions read different tokens")
                same += (f"; nll {x['nll']:.4f} → {y['nll']:.4f} ({nll_change(x['nll'], y['nll'])}), "
                         f"top1 {x['top1']:.3f} → {y['top1']:.3f}")
            md.append(f"| {label_of[n]} | {verdict(x['prefill_tps'], y['prefill_tps'])} | "
                      f"{verdict(x['gen_first_ms'], y['gen_first_ms'], False)} | "
                      f"{verdict(x['gen_steady_tps'], y['gen_steady_tps'])} | {same} |")
        rows = [(k, m) for k, m in med.items() if len(k) == 5 and k[1] == a]
        if rows:
            bus = steps_bus(steps[a]) and steps_bus(steps[b])
            md += ["", f"| tokens | steps | {OPT_COLS['expert_miss'][0]} | decode | reads' s |" +
                   " MB to the card |" * bus, "|---|---|---|---|---|" + "---|" * bus]
            for (_, _, n, lo, hi), x in rows:
                y = med.get(("steps", b, n, lo, hi))
                if y:
                    md.append(f"| {label_of[n]} | {lo + 1} to {hi + 1} | {statistics.median(x[0]):.0f} → "
                              f"{statistics.median(y[0]):.0f} | {verdict(x[1], y[1])} | "
                              f"{statistics.median(x[2]):.3f} → {statistics.median(y[2]):.3f} s |" +
                              (f" {statistics.median(x[3]):.1f} → {statistics.median(y[3]):.1f} |" if bus else ""))


def steps_bus(st):
    """Whether a version's step files carry the MB to the card (a CUDA build's)."""
    return all(g[3] is not None for s in st.values() for n in s.values() for g in n.values())


def block_stats(st, n, lo, hi):
    """Per run, over steps lo..hi of length (or turn) n: reads, tokens a second, reads' time, MB to the card."""
    reads, tps, disk, bus = [], [], [], []
    for s in st.values():
        s = s[n]
        reads.append(sum(s[g][0] for g in range(lo, hi + 1)))
        disk.append(sum(s[g][1] for g in range(lo, hi + 1)))
        tps.append((hi - lo + 1) / (sum(s[g][2] for g in range(lo, hi + 1)) / 1e3))
        bus.append(sum(s[g][3] or 0 for g in range(lo, hi + 1)))
    return reads, tps, disk, bus


def session_time(rows):
    """The time of all turns of a run: to the first token, the first step, the other steps."""
    t = 0.0
    for r in rows:
        n, tps = int(r["gen_tokens"]), float(r["gen_steady_tps"])
        t += float(r["prefill_s"]) + float(r["gen_first_ms"]) / 1e3 + ((n - 1) / tps if n > 1 and tps > 0 else 0)
    return t


def session_report(out, md, names, lab, data, steps):
    for v, rs in data.items():
        runs = list(rs.values())
        nt = len(runs[0])
        if any(len(r) != nt for r in runs):
            die(f"{v}: the runs do not all have {nt} turns")
        bus = "bus_mb" in runs[0][0]
        md += [f"## {v} {lab.get(v, '')}: {len(runs)} run{'s' * (len(runs) > 1)} (median, min–max)", "",
               "| turn | prompt | reused | read | to first token s | first step ms | decode tok/s | answer | nll | "
               f"top1 | greedy same | tool calls exact | stops | RSS GB | {OPT_COLS['expert_miss'][0]} |" +
               " MB to the card |" * bus, "|" + "---|" * (15 + bus)]
        serve = runs[0][0].get("serve") == "1"   # SERVE=1 says no reuse (serve_session): «?», not a number
        for i in range(nt):
            col = lambda k: [float(r[i][k]) for r in runs]
            r0 = runs[0][i]
            md.append(f"| {i + 1} | {r0['ctx_tokens']} | {'?' if serve else r0['reused']} | "
                      f"{'?' if serve else r0['prefill_tokens']} | "
                      f"{cell(col('prefill_s'), 2)} | {cell(col('gen_first_ms'), 0)} | "
                      f"{cell(col('gen_steady_tps'), 2)} | {r0['gen_tokens']} | {statistics.median(col('nll')):.4f} | "
                      f"{statistics.median(col('top1')):.3f} | {r0['greedy_prefix']}/{r0['gen_tokens']} | "
                      f"{r0['tool_calls_ok']}/{r0['tool_calls']} | {'yes' if r0['stop_ok'] == '1' else 'no'} | "
                      f"{statistics.median(col('rss_gb')):.2f} | {statistics.median(col('expert_miss')):.0f} |" +
                      (f" {statistics.median(col('bus_mb')):.1f} |" if bus else ""))
        r0 = runs[0]
        times = [session_time(r) for r in runs]
        answer = sum(int(r["gen_tokens"]) for r in r0)
        bad = [i + 1 for i in range(nt) if len({r[i]["fingerprint"] for r in runs}) > 1]
        read = (f"prompts {sum(int(r['ctx_tokens']) for r in r0)} tokens (SERVE=1 does not say what the engine reused)"
                if serve else f"prompts read {sum(int(r['prefill_tokens']) for r in r0)} tokens, reused "
                              f"{sum(int(r['reused']) for r in r0)}")
        md += ["", f"session: {nt} turns; {read}; all turns {cell(times, 1)} s; to first token in all "
               f"{cell([sum(float(r['prefill_s']) for r in g) for g in runs], 1)} s; answers {answer} tokens, nll "
               f"{sum(float(r['nll']) * int(r['gen_tokens']) for r in r0) / answer:.4f}, top1 "
               f"{sum(float(r['top1']) * int(r['gen_tokens']) for r in r0) / answer:.3f}; tool calls exact "
               f"{sum(int(r['tool_calls_ok']) for r in r0)} of {sum(int(r['tool_calls']) for r in r0)}; turns that "
               f"stop {sum(r['stop_ok'] == '1' for r in r0)} of {nt}",
               f"fingerprints equal in every run: {'yes' if not bad else f'NO, turns {bad}'}", ""]
    vs = list(data)
    if len(vs) == 2:
        ga, gb = [list(data[v].values()) for v in vs]
        if len(ga[0]) != len(gb[0]):
            md.append("the two versions have different turns: no comparison")
            return
        serve = ga[0][0].get("serve") == "1"   # through SERVE=1: the answers are forced inside each next prompt
        same = all((serve or ga[0][i]["tokens"] == gb[0][i]["tokens"]) and ga[0][i]["ctx_tokens"] == gb[0][i]["ctx_tokens"]
                   for i in range(len(ga[0])))
        md += [f"## {vs[1]} {lab.get(vs[1], '')} against {vs[0]} {lab.get(vs[0], '')} (medians of {len(ga)} and "
               f"{len(gb)} runs; positive = faster)",
               "", f"same prompts{' (through SERVE=1: the answers forced inside the next prompt)' if serve else ' and teacher-forced answers'}: "
                   f"{'yes' if same else 'NO: no comparison'}"]
        if not same:
            return
        md += ["", "| turn | to first token | first step | decode | nll | experts read | results |",
               "|---|---|---|---|---|---|---|"]
        for i in range(len(ga[0])):
            col = lambda g, k: [float(r[i][k]) for r in g]
            fa, fb = {r[i]["fingerprint"] for r in ga}, {r[i]["fingerprint"] for r in gb}
            md.append(f"| {i + 1} | {verdict(col(ga, 'prefill_s'), col(gb, 'prefill_s'), False)} | "
                      f"{verdict(col(ga, 'gen_first_ms'), col(gb, 'gen_first_ms'), False)} | "
                      f"{verdict(col(ga, 'gen_steady_tps'), col(gb, 'gen_steady_tps'))} | "
                      f"{statistics.median(col(gb, 'nll')) - statistics.median(col(ga, 'nll')):+.4f} | "
                      f"{statistics.median(col(ga, 'expert_miss')):.0f} → "
                      f"{statistics.median(col(gb, 'expert_miss')):.0f} | "
                      f"{'same results' if len(fa) == 1 and fa == fb else 'logits differ'} |")
        md += ["", f"all turns: {verdict([session_time(r) for r in ga], [session_time(r) for r in gb], False)}; "
               f"to first token in all: "
               f"{verdict([sum(float(r['prefill_s']) for r in g) for g in ga], [sum(float(r['prefill_s']) for r in g) for g in gb], False)}"]


# ------------------------------------------------------------------------------------------------- manifest
def manifest(a):
    """The record for c/experiment_manifest.py: the prompt's or the decode's speed (--metric) at the longest length
    in each run of each version, and the machine that measured (setup.txt's, not the one running this)."""
    out = Path(a.out)
    names, data = run_names(out), None
    if len(names) != 2:
        die("a manifest compares two versions")
    data = {v: [read_csv(out / f"{r}.csv") for r in rs] for v, rs in names.items()}
    if min(len(d) for d in data.values()) < MIN_VERDICT:
        die(f"a manifest needs {MIN_VERDICT} runs a version: " + ", ".join(f"{v} has {len(d)}" for v, d in data.items()))
    if len({len(rows) for d in data.values() for rows in d}) > 1:
        die("the runs do not all have the same rows, one was cut short")
    setup = (out / "setup.txt").read_text()
    hw = re.search(r"^hardware: (.*)$", setup, re.M)
    if not hw:
        die("setup.txt has no hardware line (a measurement before 29/10): write the record's hardware by hand")
    cfg = {}
    for v in names:
        m = re.search(rf"^{v} [^:\s]+: (.+?) \((.*)\); env: (.*)$", setup, re.M)
        if not m:
            die("setup.txt was not written by bench run")
        env = {} if m.group(3) == "none" else dict(x.split("=", 1) for x in m.group(3).split())
        cfg[v] = {"HARNESS": m.group(2), **env}
    keys = sorted(set(cfg["v0"]) | set(cfg["v1"]))
    changed = [k for k in keys if cfg["v0"].get(k) != cfg["v1"].get(k)]
    if len(changed) != 1:
        die(f"the two versions differ in {changed or 'nothing'}: a manifest changes one variable")
    for v in cfg:
        for k in keys:
            cfg[v].setdefault(k, "unset")
    n = max(int(r["ctx_tokens"]) for r in data["v0"][0])
    col = {"prompt": "prefill_tps", "decode": "gen_steady_tps"}[a.metric]
    s0, s1 = ([float(next(r for r in rows if int(r["ctx_tokens"]) == n)[col]) for rows in data[v]]
              for v in ("v0", "v1"))
    rows = range(len(data["v0"][0]))   # the same logits: each row one fingerprint in every run of both versions
    if all(len({d[i]["fingerprint"] for v in data for d in data[v]}) == 1 for i in rows):
        quality = "the fingerprint of every logit is the same in every run of both versions, at every length"
    elif not a.quality:
        die("the logits change between the versions: say how quality was checked, --quality \"...\"")
    else:   # the person's check, and the numbers beside it
        quality = a.quality
        if "nll" in data["v0"][0][0] and float(data["v0"][0][0]["nll"]) > 0:
            med = lambda v, i, k: statistics.median(float(d[i][k]) for d in data[v])
            quality += "; teacher-forced (medians), " + ", ".join(
                f"{data['v0'][0][i]['ctx_tokens']} tokens: nll {med('v0', i, 'nll'):.4f} → {med('v1', i, 'nll'):.4f}"
                f", top1 {med('v0', i, 'top1'):.3f} → {med('v1', i, 'top1'):.3f}" for i in rows)
    outcome = "improvement" if min(s1) > max(s0) else "regression" if max(s1) < min(s0) else "no-change"
    ev = {"uri": a.evidence_uri or str(a.evidence), "sha256": sha256(a.evidence)}
    model = re.search(r"^model (\S+);", setup, re.M).group(1)

    def arm(v, s):
        return {"config": cfg[v], "samples": {"tok_s": s}, "median_tok_s": statistics.median(s),
                "quality": {"method": quality, "passed": True}, "evidence": ev}
    rec = {"version": 1, "hypothesis": a.hypothesis, "commit": a.commit, "model": Path(model).name,
           "metric": f"{a.metric} tok/s at {n} tokens",
           "command": re.search(r"^v1 [^:\s]+: .*\n   command: (.*)$", setup, re.M).group(1),
           "prompt_hash": re.search(r"sha256 ([0-9a-f]+)\)", setup).group(1) if "sha256" in setup else "session",
           "hardware": json.loads(hw.group(1)), "warmup_runs": 1, "changed_variables": changed,
           "baseline": arm("v0", s0), "trial": arm("v1", s1), "outcome": outcome}
    print(json.dumps(rec, indent=2, ensure_ascii=False))


def main():
    p = argparse.ArgumentParser(prog="bench", description=__doc__.split("\n\n")[0])
    sub = p.add_subparsers(dest="cmd", required=True)
    b = sub.add_parser("build", help="the harness against a commit or a source directory")
    b.add_argument("target"), b.add_argument("out")
    for q in (b, r := sub.add_parser("run", help="warm-up, then runs in ABBA order, then the report")):
        q.add_argument("--cuda", action="store_true", help="build with CUDA=1 (Linux)")
        q.add_argument("--engine", default="qwen36", choices=sorted(ENGINES))
        q.add_argument("--repo", help="the git repository of the commits (default: the one around cwd or bench)")
