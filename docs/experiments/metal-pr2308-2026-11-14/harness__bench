def parse_version(spec, out, a, engine):
    head, *env = spec.split(",")
    label, _, target = head.partition("=") if "=" in head and not head.startswith(("/", ".")) else ("", "", head)
    for v in env:
        if not re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", v):
            die(f"{spec}: '{v}' is not VAR=VAL")
    if label and not re.fullmatch(r"[A-Za-z0-9_.-]+", label):   # setup.txt's readers take a label as one word
        die(f"{spec}: a label is letters, digits, _ . -")
    p = Path(target)
    if p.is_file():
        binary = p.resolve()
        version = (p.parent / "version.txt").read_text().strip() if (p.parent / "version.txt").exists() else "?"
        label = label or re.sub(r"[^A-Za-z0-9_.-]", "_", p.parent.name)
    else:
        name = re.sub(r"[^A-Za-z0-9_.-]", "_", label or (p.name if p.is_dir() else target[:8]))
        d = Path(out) / f"bin-{name}"   # build() writes version.txt here, also when the binary is the tree's (SERVE=1)
        binary = build(target, d, engine, a.cuda, a.repo, a.make, getattr(a, "serve_model", None))
        version = (d / "version.txt").read_text().strip()
        label = label or name
    return {"label": label, "binary": binary, "env": env, "version": version}


SESSION_COLS = ("ctx_tokens,prefill_tokens,prefill_s,prefill_tps,gen_tokens,gen_first_ms,gen_steady_tps,expert_miss,"
                "disk_s,fingerprint,tokens,nll,top1,reused,kv_len,rss_gb,greedy_prefix,tool_calls,tool_calls_ok,stop_ok,"
                "serve")   # qwen36_bench.c's session columns, and serve = 1


def serve_session(a):
    """The harness of a session through SERVE=1, for any engine the server runs (bench run --session <x.json>).
    The engine starts as openai_server.py starts it (its Engine, next to the binary); every turn is the
    conversation before an assistant message, rendered as the server renders a request that sets neither thinking
    nor effort; each SUBMIT asks pin=1, the state after its prompt photographed, so the next turn, whose prompt
    carries the transcript's answer, resumes from the photo: the answers are forced, read with the next prompt
    instead of one token at a time as qwen36_bench.c does. The CSV of qwen36_bench.c's sessions on stdout (nll and
    top1 nan: SERVE gives no logits; fingerprint and tokens a hash of the answer's text), the engine's stderr in
    the run's .err. SERVE says no reuse (DONE's cache_hit_percent is the expert cache's hit rate, qwen38.c
    q38_cache_hit_percent): reused is -1 and read the whole prompt, the times say what the photo saved; run checks
    the photos in the .err (photos())."""
    c = Path(a.engine_bin).resolve().parent
    sys.path.insert(0, str(c))
    import openai_server as osv
    family = osv.resolve_model(a.model).descriptor
    osv.ARCH, osv.CHAT_FLAVOR = family.id, osv.detect_chat_flavor(family.id, a.model)
    # the server's defaults for a request that sets neither (openai_server.py, anthropic_messages)
    think = (osv.chat_flavor() in ("qwen38", "lfm3") or osv.ARCH == "mimo") and \
        not (osv.ARCH == "olmoe" or osv.chat_flavor() == "qwen3_coder")
    effort = ("xhigh" if osv.chat_flavor() == "qwen38" else "high") if think else None
    data = json.loads(Path(a.session).read_text(encoding="utf-8"))
    msgs, tools = data["messages"], data.get("tools")
    turns = [i for i, m in enumerate(msgs) if m.get("role") == "assistant"]
    if not turns:
        die(f"{a.session}: no assistant message, no turn")
    prompts = [osv.render_chat_for_arch(msgs[:i], think, effort, tools, None, add_generation_prompt=True,
                                        preserve_thinking=not think) for i in turns]
    print(f"[bench] session {Path(a.session).name} through SERVE=1: {len(turns)} turns, family {family.id}"
          f"{f', template {osv.CHAT_FLAVOR}' if osv.CHAT_FLAVOR else ''}, thinking {'on (' + effort + ')' if think else 'off'}, "
          f"{a.gen} words a turn, pin=1 on every turn", file=sys.stderr, flush=True)
    eng = osv.Engine(str(a.engine_bin), a.model, None, a.gen, dict(os.environ), 1, family)
    print(SESSION_COLS, flush=True)
    steps = open(a.steps, "w") if a.steps else None
    prev_p = None
    for k, p in enumerate(prompts):
        got, at = [], []

        def on_text(t):
            at.append(time.perf_counter())
            got.append(t)

        t0 = time.perf_counter()
        st = eng.generate(p, a.gen, 0.0, 1.0, on_text, pin=True)
        n, np_ = st["completion_tokens"], st["prompt_tokens"]
        first = at[0] - t0 if at else time.perf_counter() - t0
        h = hashlib.sha256("".join(got).encode()).hexdigest()[:16]
        print(f"{np_},{np_},{first:.3f},{np_ / first if first > 0 else 0:.2f},{n},"
              f"{(at[1] - at[0]) * 1e3 if len(at) > 1 else 0:.1f},{st['tokens_per_second']:.3f},0,0.00,{h},{h},nan,nan,"
              f"-1,{np_ + n},{st['rss_gb']:.2f},0,0,0,{0 if st['length_limited'] else 1},1", flush=True)
        if steps:   # the step file's contract (read_steps): the prompt as step -1, then a line a word after the first
            steps.write(f"{k + 1} -1 0 0.00 {first * 1e3:.1f}\n" + "".join(
                f"{k + 1} {i - 1} 0 0.00 {(at[i] - at[i - 1]) * 1e3:.1f}\n" for i in range(1, len(at))))
        print(f"[bench] turn {k + 1}: prompt {np_} tokens, first word after {first:.2f} s, answer {n} tokens at "
              f"{st['tokens_per_second']:.2f} tok/s (the engine's), RSS {st['rss_gb']:.2f} GB", file=sys.stderr, flush=True)
        if prev_p is not None and not p.startswith(prev_p):
            print(f"[bench] turn {k + 1}: the server renders turn {k}'s prompt otherwise inside this one (the template "
                  f"rewrites the history): no photo can match, the turn reads what changed", file=sys.stderr)
        prev_p = p
    eng.close()
    if steps:
        steps.close()


def photos(err):   # the photos an engine took through SERVE=1: each says «[PIN] scatto a N token» on stderr
    return err.read_text(errors="replace").count("[PIN] scatto a ")


def last_line(err):   # what a failed run said last, for the line that names the failure
    lines = [l for l in err.read_text(errors="replace").splitlines() if l.strip()]
    return lines[-1][:200] if lines else "nothing"


def harness_args(a, model, steps):
    if a.session:
        args = ["--session", str(a.session)]
    else:
        args = ["--text", str(a.text), "--lengths", a.lengths, "--gen", str(a.gen)]
        args += ["--photo"] * a.photo + ["--teacher"] * (not a.free)
    if a.pause:
        args += ["--pause", str(a.pause)]
    if a.argv:
        args += ["--argv", a.argv]
    return ["--model", model] + args + ["--steps", steps]


def run(a):
    global GPU
    e = ENGINES[a.engine]
    out = Path(a.out).resolve()
    if out.exists() and any(out.glob("*.csv")):
        die(f"{out} already holds a measurement")
    if SYSTEM == "Darwin" and chrome() and not a.chrome_ok:
        die("Chrome is open: close it (or --chrome-ok for a test that measures nothing)")
    lock = open(LOCK, "w")   # held to the end of the process: another measurement waiting for the cool or resting
    try:                     # between two runs has no process to see
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        die(f"another bench run holds {LOCK}: a measurement needs the machine alone")
    b = busy([e["binary"]])
    if b:
        die(f"{b} is running: a measurement needs the machine alone")
    if SYSTEM == "Linux":
        if gpus() > 1 and a.gpu is None:
            die(f"{gpus()} cards: --gpu names the one the engine uses (the bench reads that one)")
        GPU = str(a.gpu or 0)
    for x in a.env:
        if not re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", x):
            die(f"--env {x}: not VAR=VAL")
    a.serve = isinstance(a.session, str) and a.session.endswith(".json")   # a transcript: any engine, through SERVE=1
    if a.serve and sys.version_info < (3, 10):   # serve_session imports the tree's openai_server.py (slots dataclasses)
        die(f"--session {a.session}: the server's code wants Python 3.10 or later, this is {platform.python_version()}: "
            f"run bench with python3.12")
    for asked, key, what in ((a.session and not a.serve, "session", "--session"), (a.photo or a.sweep, "photo", "--photo and --sweep"),
                             (a.argv, "argv", "--argv")):
        if asked and not e.get(key):
            die(f"{what}: the {a.engine} harness does not take it")
    if a.argv and not re.fullmatch(r"[0-9A-Za-z_.-]+(,[0-9A-Za-z_.-]+)*", a.argv):
        die(f"--argv {a.argv}: the engine's positional arguments, separated by commas")
    if a.sweep:
        # the top is chosen with the user after the memory check (guida-benchmark.md); the step is the smallest of
        # 1024, 2048, 4096 that keeps the frontiers within 16, and the sweep starts at its step
        if a.lengths:
            die("--sweep chooses the lengths: drop --lengths")
        if not a.ctx_max:
            die("--sweep needs --ctx-max: the guide wants it chosen with the user, after the memory check")
        if a.ctx_max > SWEEP_MAX:
            die(f"--ctx-max {a.ctx_max}: the sweep goes to {SWEEP_MAX} at most")
        a.step = a.step or next(s for s in (1024, 2048, 4096) if a.ctx_max // s <= 16)
        lens = list(range(a.ctx_start or a.step, a.ctx_max + 1, a.step))
        if not lens:
            die(f"--ctx-max {a.ctx_max} is under the sweep's first frontier, {a.ctx_start or a.step}")
        if len(lens) > 16:
            die(f"the sweep has {len(lens)} frontiers: 16 at most")
        a.lengths, a.photo = ",".join(map(str, lens)), True
    a.lengths = a.lengths or "64,512,64"
    if not re.fullmatch(r"\d+(,\d+)*", a.lengths):
        die(f"--lengths {a.lengths}: numbers separated by commas")
    if a.gen is None:
        a.gen = 128 if a.sweep else 32   # ds4-bench's 128 at each frontier; 32 for the base
    lens = [int(x) for x in a.lengths.split(",")] if not a.session else []
    if a.photo and any(y <= x for x, y in zip(lens, lens[1:])):
        die("--photo: each length continues the previous one, so they must grow")
    if a.session:
        a.session = Path(e["session"] if a.session is True else a.session).resolve()
    if a.text in TEXTS:
        a.text = TEXTS[a.text]
    a.text = Path(a.text).resolve()
    # --env-only: the variables coli gives the engine (/proc/<pid>/environ) and nothing of the owner's usage
    model, env = a.model or e["model"].get(SYSTEM), [] if a.env_only else e["env"].get(SYSTEM, [])
    if SYSTEM == "Linux":
        # the owner's OMP_PROC_BIND=close alone binds a thread to a logical CPU: on Colab's VMs the team lands on SMT
        # siblings, half the cores; cores gives each thread a core of its own
        env += ["OMP_PLACES=cores"] * (a.threads == "cores") + OMP_SHOW
    elif a.threads != "owner":
        die("--threads: Linux only (macOS does not bind threads)")
    env += a.env
    if a.accel:
        if SYSTEM not in e["accel"]:
            die(f"--accel: no accelerated mode for {a.engine} on {SYSTEM}")
        model = a.model or e["accel"][SYSTEM][0]
        env = e["accel"][SYSTEM][1] + env
    if not model:
        die("--model: no default model on this system")
    out.mkdir(parents=True, exist_ok=True)
    a.serve_model = model if a.serve else None
    versions = [parse_version(v, out, a, a.engine) for v in a.versions]
    if len({v["label"] for v in versions}) < len(versions):
        die("two versions with the same label: name them, label=...")
    for v in versions:
        v["unread"] = unread(v["binary"], env + v["env"])
        if v["unread"] and not a.unread_ok:
            die(f"{v['label']}: the binary never names {' '.join(v['unread'])}: a typo, or a build without that "
                f"mode? (--unread-ok runs it anyway, and the summary says so)")
    runs = a.runs or (4 if len(versions) == 2 else 3)
    keep = ["PATH=/usr/bin:/bin", f"HOME={os.environ.get('HOME', '/tmp')}"]
    for k in ("LD_LIBRARY_PATH", "CUDA_VISIBLE_DEVICES") if SYSTEM == "Linux" else ():
        if k in os.environ:
            keep.append(f"{k}={os.environ[k]}")

    def command(v, name):   # env keeps the last of a name: a version's own variables win over every default
        if a.serve:   # the engine's main through SERVE=1, driven by this file (serve_session)
            return ["env", "-i"] + keep + env + v["env"] + time_cmd() + \
                [sys.executable, str(Path(__file__).resolve()), "serve-session", str(v["binary"]), "--model", model,
                 "--session", str(a.session), "--gen", str(a.gen), "--steps", str(out / f"{name}.steps")]
        return ["env", "-i"] + keep + env + v["env"] + time_cmd() + [str(v["binary"])] + \
            harness_args(a, model, str(out / f"{name}.steps"))

    what = (f"session {Path(a.session).name}{' through SERVE=1, pin=1 a turn, ' + str(a.gen) + ' words a turn' if a.serve else ''}" if a.session else
            f"text {a.text.name} (sha256 {sha256(a.text)[:16]}); lengths {a.lengths}; gen {a.gen}; "
            f"{'free (most likely token, never the end)' if a.free else 'teacher-forced'}"
            f"{'; photo: each length continues the previous one' if a.photo else ''}"
            f"{f'; pause {a.pause} s' if a.pause else ''}")
    hw = hardware()
    setup = [f"bench {sha256(Path(__file__))[:12]}; engine {a.engine}; {SYSTEM} ({hw['cpu']}"
             f"{', ' + hw['gpu'] if 'gpu' in hw else ''}); {datetime.now():%Y-%m-%d %H:%M}",
             f"model {model}; {what}{'; accelerated' if a.accel else ''}",
             f"runs: a warm-up of v0 (does not count), then {runs} per version"
             f"{', the order turning at every round (ABBA)' if len(versions) == 2 else ''}; before every run: "
             f"{'no wait' if a.no_wait_cool else 'wait until cool (at most 900 s)'}"
             f"{f', the card under {a.max_temp} °C' if SYSTEM == 'Linux' else ''}, then {a.rest} s of rest"]
    if SYSTEM == "Linux":
        bind = [x for x in env if x.startswith(("OMP_PROC_BIND=", "OMP_PLACES="))]
        setup.append(f"while running: card {GPU} read every {WATCH_MS} ms (<run>.gpu.txt); threads: {a.threads} "
                     f"({' '.join(bind) or 'not bound: no OMP_PROC_BIND or OMP_PLACES'})")
    setup.append(f"hardware: {json.dumps(hw, ensure_ascii=False)}")   # bench manifest's, from the measuring machine
    for i, v in enumerate(versions):
        setup.append(f"v{i} {v['label']}: {v['binary']} ({v['version']}); env: {' '.join(env + v['env']) or 'none'}")
        setup.append(f"   command: {shlex.join(command(v, f'v{i}-runN'))}")
    for i, v in enumerate(versions):
        if v["unread"]:
            setup.append(f"warning: v{i} {v['label']}: the binary never names {' '.join(v['unread'])}")
    if runs % 2 and len(versions) == 2:
        setup.append("warning: an odd number of rounds does not cancel a drift")
    if runs < MIN_VERDICT and len(versions) == 2:
        setup.append(f"warning: {runs} run{'s' * (runs > 1)} a version: a check, not a measure (no verdicts)")
    (out / "setup.txt").write_text("\n".join(setup) + "\n")
    print("\n".join(setup))
    (out / "host-before.txt").write_text(host_state() + "\n")
    if SYSTEM == "Linux" and not FAKE:
        (out / "cpus.txt").write_text(cpu_cores())

    def one(i, name):
        waited = 0 if a.no_wait_cool else cool(a.max_temp)
        time.sleep(a.rest)
        b = busy([e["binary"]])
        if b:
            die(f"{b} is running before {name}: a measurement needs the machine alone")
        state = thermal()
        if SYSTEM == "Darwin":
            (out / f"{name}.power-before.txt").write_text(sh(["pmset", "-g", "batt"]))
        (out / f"{name}.thermal-before.txt").write_text(
            f"{datetime.now():%Y-%m-%d %H:%M:%S}\n{state}\n{swap()}\nwaited until cool: {waited}s\n")
        if not is_cool(state, a.max_temp):
            die(f"{name}: NOT COOL ({state}), after {waited} s: stopped before timing; preserve this attempt")
        with open(out / f"{name}.csv", "w") as o, open(out / f"{name}.err", "w") as er, \
                watch(out / f"{name}.gpu.txt", out / f"{name}.err"):
            rc = subprocess.run(command(versions[i], name), stdout=o, stderr=er).returncode
        (out / f"{name}.thermal-after.txt").write_text(f"{datetime.now():%Y-%m-%d %H:%M:%S}\n{thermal()}\n{swap()}\n")
        if SYSTEM == "Darwin":
            (out / f"{name}.power-after.txt").write_text(sh(["pmset", "-g", "batt"]))
        print(f"{name}: exit {rc}", flush=True)
        if rc:
            (out / "host-after.txt").write_text(host_state() + "\n")
            die(f"{name} failed ({out / f'{name}.err'}): {last_line(out / f'{name}.err')}")
        if a.serve:   # pin=1 kept: every engine says each photo it takes (qwen36.c pin_save, qwen38.c, olmoe.c)
            got = photos(out / f"{name}.err")
            turns = sum(1 for l in (out / f"{name}.csv").read_text().splitlines() if l[:1].isdigit())
            if got < turns:
                die(f"{name}: {got} photos for {turns} turns: the engine did not keep the state after each prompt "
                    f"(pin=1, «[PIN] scatto a» in {out / f'{name}.err'})")

    one(0, "warmup")
    for r in range(1, runs + 1):
        for i in (range(len(versions)) if r % 2 else reversed(range(len(versions)))):
            one(i, f"v{i}-run{r}")
    (out / "host-after.txt").write_text(host_state() + "\n")
    report(out)


